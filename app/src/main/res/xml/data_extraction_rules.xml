<?xml version="1.0" encoding="utf-8"?>
<!--
   Settings are backed up and transferred so the language pair and options follow the user. The
   Gemini API key in that file is encrypted with a Keystore key that never leaves the device
   (see KeystoreSecretCipher): a restored copy cannot be read and the key is asked for again.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
